# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. For Supabase/Neon use the pooled URL here and
# set DIRECT_URL only if you add `directUrl` to prisma/schema.prisma.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/myhub?schema=public"

# ─── Auth.js ─────────────────────────────────────────────────────────────────
# Required. Generate with: openssl rand -base64 32
AUTH_SECRET=""
# Set to true when running behind a proxy/host that sets the Host header (Vercel, Docker, Railway).
AUTH_TRUST_HOST=true
# Set to false after creating your own account to stop anyone else registering.
ALLOW_REGISTRATION=true
# Show the demo login hint on the sign-in page (only useful if you ran the seed).
SHOW_DEMO_HINT=false

# ─── Scheduled jobs ──────────────────────────────────────────────────────────
# Protects /api/cron/run (min. 16 chars). Generate with: openssl rand -hex 24
# Without it, reminders/recurring entries are only processed when you open the app.
CRON_SECRET=""

# ─── File storage (document vault) ───────────────────────────────────────────
# "local" writes to LOCAL_STORAGE_DIR (needs a persistent disk; NOT suitable for Vercel).
# "supabase" uses a PRIVATE Supabase Storage bucket via the service-role key (server only).
STORAGE_DRIVER=local
LOCAL_STORAGE_DIR="./storage"
MAX_UPLOAD_MB=10
# SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY=""   # never expose this to the browser; it is only read on the server
# SUPABASE_STORAGE_BUCKET="myhub-documents"
